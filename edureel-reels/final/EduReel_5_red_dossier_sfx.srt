1
00:00:00,510 --> 00:00:02,230
إذا الإنسان أصلًا

2
00:00:02,970 --> 00:00:04,100
لا يعرف جسده

3
00:00:04,100 --> 00:00:05,360
فكيف يعرف نفسه؟

4
00:00:05,360 --> 00:00:06,060
الإنسان لا يعرف كيف

5
00:00:06,060 --> 00:00:07,620
يبدو وهو يمشي

6
00:00:08,290 --> 00:00:08,960
ولا يعرف كيف يبدو

7
00:00:08,960 --> 00:00:09,380
وهو جالس

8
00:00:09,380 --> 00:00:10,540
ولا

9
00:00:10,660 --> 00:00:12,670
يعرف وجهه

10
00:00:13,280 --> 00:00:14,380
وفي مناطق من جسمه

11
00:00:14,380 --> 00:00:14,900
ما قد شافها

12
00:00:14,900 --> 00:00:16,200
في مناطق من جسمه

13
00:00:16,200 --> 00:00:17,300
ما قد لمسها

14
00:00:17,300 --> 00:00:18,460
مرة سووا دراسة

15
00:00:18,460 --> 00:00:20,060
جابوا اليدين بهذه

16
00:00:20,060 --> 00:00:21,740
الطريقة وصوروها

17
00:00:22,160 --> 00:00:22,780
كل اثنين جابوا كده

18
00:00:22,780 --> 00:00:24,220
يديهم وصوروها

19
00:00:24,330 --> 00:00:25,450
بعدين جابوا قصوها

20
00:00:25,450 --> 00:00:26,030
وخلطوها

21
00:00:26,030 --> 00:00:26,560
قالوا كل واحد يدوّر

22
00:00:26,560 --> 00:00:27,720
يديه

23
00:00:27,990 --> 00:00:29,320
٨٦ ٪ لم يتعرفوا

24
00:00:29,320 --> 00:00:30,120
على يديهم

25
00:00:30,120 --> 00:00:32,040
الإنسان يسجل صوته

26
00:00:32,620 --> 00:00:33,370
ويسمع يقول لك هذا

27
00:00:33,370 --> 00:00:34,130
صوتي؟

28
00:00:34,130 --> 00:00:35,530
فما تحب تسمع صوته

29
00:00:35,530 --> 00:00:36,890
ويستقبحه ويستنكره

30
00:00:36,890 --> 00:00:38,960
نقول له هذا صوتك

31
00:00:38,960 --> 00:00:39,700
إحنا لا نعرف هذا

32
00:00:39,700 --> 00:00:40,200
الجسد

33
00:00:40,200 --> 00:00:42,020
فما بالك بالنفس

34
00:00:42,740 --> 00:00:44,166
فالإنسان لا يعرف نفسه

